
#Область ОбработчикиСобытий

Функция ПоступленияПринятьПоступление(Запрос)
	
	#Область ПроверкаДанных
	
	// Получаем JSON из запроса
	ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
	
	Если ПустаяСтрока(ТелоЗапроса) Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;
	
	// Читаем JSON
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеПоступления = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
	Исключение
		
		Возврат Новый HTTPСервисОтвет(400);
		
	КонецПопытки;
	
	// Проверяем структуру и обязательные поля
	Если ТипЗнч(ДанныеПоступления) <> Тип("Структура") Тогда
		Возврат Новый HTTPСервисОтвет(400);
	КонецЕсли;
	
	Если Не ДанныеПоступления.Свойство("Контрагент")
		Или Не ДанныеПоступления.Свойство("Склад")
		Или Не ДанныеПоступления.Свойство("Товары") Тогда
		
		Возврат Новый HTTPСервисОтвет(400);
		
	КонецЕсли;
	
	// Проверяем контрагента, склад и массив товаров
	Если ТипЗнч(ДанныеПоступления.Контрагент) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ДанныеПоступления.Контрагент)
		Или ТипЗнч(ДанныеПоступления.Склад) <> Тип("Строка")
		Или Не ЗначениеЗаполнено(ДанныеПоступления.Склад)
		Или ТипЗнч(ДанныеПоступления.Товары) <> Тип("Массив")
		Или ДанныеПоступления.Товары.Количество() = 0 Тогда
		
		Возврат Новый HTTPСервисОтвет(400);
		
	КонецЕсли;
	
	// Проверяем склад
	Склад = Справочники.Склады.НайтиПоНаименованию(ДанныеПоступления.Склад);
	
	Если Склад.Пустая() Или Склад.Наименование <> "Основной" Тогда
		
		Возврат Новый HTTPСервисОтвет(400);
		
	КонецЕсли;
	
	// Проверяем строки товаров
	Для Каждого СтрокаТовара Из ДанныеПоступления.Товары Цикл
		
		Если ТипЗнч(СтрокаТовара) <> Тип("Структура") Тогда
			Возврат Новый HTTPСервисОтвет(400);
		КонецЕсли;
		
		// Проверяем обязательные поля
		Если Не СтрокаТовара.Свойство("Товар")
			Или Не СтрокаТовара.Свойство("Количество")
			Или Не СтрокаТовара.Свойство("Цена")
			Или Не СтрокаТовара.Свойство("Сумма")
			Или Не СтрокаТовара.Свойство("НаборСвойств")
			Или Не СтрокаТовара.Свойство("ДатаПоступления") Тогда
			
			Возврат Новый HTTPСервисОтвет(400);
			
		КонецЕсли;
		
		// Проверяем строковые значения
		Если ТипЗнч(СтрокаТовара.Товар) <> Тип("Строка")
			Или Не ЗначениеЗаполнено(СтрокаТовара.Товар)
			Или ТипЗнч(СтрокаТовара.НаборСвойств) <> Тип("Строка")
			Или Не ЗначениеЗаполнено(СтрокаТовара.НаборСвойств)
			Или ТипЗнч(СтрокаТовара.ДатаПоступления) <> Тип("Строка")
			Или Не ЗначениеЗаполнено(СтрокаТовара.ДатаПоступления) Тогда
			
			Возврат Новый HTTPСервисОтвет(400);
			
		КонецЕсли;
		
		// Проверяем числовые значения
		Если ТипЗнч(СтрокаТовара.Количество) <> Тип("Число")
			Или ТипЗнч(СтрокаТовара.Цена) <> Тип("Число")
			Или ТипЗнч(СтрокаТовара.Сумма) <> Тип("Число")
			Или СтрокаТовара.Количество <= 0
			Или СтрокаТовара.Цена < 0
			Или СтрокаТовара.Сумма < 0 Тогда
			
			Возврат Новый HTTPСервисОтвет(400);
			
		КонецЕсли;
		
		// Проверяем формат даты
		Если СтрДлина(СтрокаТовара.ДатаПоступления) <> 10
			Или Сред(СтрокаТовара.ДатаПоступления, 5, 1) <> "-"
			Или Сред(СтрокаТовара.ДатаПоступления, 8, 1) <> "-" Тогда
			
			Возврат Новый HTTPСервисОтвет(400);
			
		КонецЕсли;
		
		// Проверяем корректность календарной даты
		Попытка
			
			ДатаПоступления = Дата(
			Число(Лев(СтрокаТовара.ДатаПоступления, 4)),
			Число(Сред(СтрокаТовара.ДатаПоступления, 6, 2)),
			Число(Сред(СтрокаТовара.ДатаПоступления, 9, 2)));
			
		Исключение
			
			Возврат Новый HTTPСервисОтвет(400);
			
		КонецПопытки;
		
	КонецЦикла;
	
	#КонецОбласти
	
	
	#Область СозданиеДанных
	
	Попытка
		
		НачатьТранзакцию();
		
		// Ищем или создаём контрагента
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ДанныеПоступления.Контрагент, Истина);
		
		Если Контрагент.Пустая() Тогда
			
			НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			НовыйКонтрагент.Наименование = ДанныеПоступления.Контрагент;
			НовыйКонтрагент.Записать();
			
			Контрагент = НовыйКонтрагент.Ссылка;
			
		КонецЕсли;
		
		// Создаём документ поступления
		ДокументОбъект = Документы.ПоступлениеТоваров.СоздатьДокумент();
		
		ДокументОбъект.Контрагент = Контрагент;
		ДокументОбъект.Склад = Склад;
		ДокументОбъект.Дата = ТекущаяДата();
		
		// Получаем вид свойства даты поступления
		ВидСвойства = ПланыВидовХарактеристик.СвойстваТоваров.НайтиПоНаименованию("ДатаПоступления");
		
		Если ВидСвойства.Пустая() Тогда
			ВызватьИсключение "Не найдено свойство ДатаПоступления.";
		КонецЕсли;
		
		// Обрабатываем товары
		Для Каждого СтрокаТовара Из ДанныеПоступления.Товары Цикл
			
			// Ищем или создаём товар
			Товар = Справочники.Товары.НайтиПоНаименованию(СтрокаТовара.Товар, Истина);
			
			Если Товар.Пустая() Тогда
				
				НовыйТовар = Справочники.Товары.СоздатьЭлемент();
				НовыйТовар.Наименование = СтрокаТовара.Товар;
				НовыйТовар.Записать();
				
				Товар = НовыйТовар.Ссылка;
				
			КонецЕсли;
			
			// Создаём новую партию из JSON
			НоваяПартия = Справочники.ВариантыТоваров.СоздатьЭлемент();
			НоваяПартия.Владелец = Товар;
			НоваяПартия.Наименование = СтрокаТовара.НаборСвойств;
			НоваяПартия.Записать();
			
			// Преобразуем дату поступления
			ДатаПоступления = Дата(
			Число(Лев(СтрокаТовара.ДатаПоступления, 4)),
			Число(Сред(СтрокаТовара.ДатаПоступления, 6, 2)),
			Число(Сред(СтрокаТовара.ДатаПоступления, 9, 2)));
			
			// Записываем дату партии в регистр сведений
			МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствТоваров.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.НаборСвойств = НоваяПартия.Ссылка;
			МенеджерЗаписи.ВидСвойства = ВидСвойства;
			МенеджерЗаписи.Значение = ДатаПоступления;
			
			МенеджерЗаписи.Записать();
			
			// Добавляем строку в документ
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			
			НоваяСтрока.Товар = Товар;
			НоваяСтрока.НаборСвойств = НоваяПартия.Ссылка;
			НоваяСтрока.Количество = СтрокаТовара.Количество;
			НоваяСтрока.Цена = СтрокаТовара.Цена;
			НоваяСтрока.Сумма = СтрокаТовара.Сумма;
			
		КонецЦикла;
		
		// Записываем и проводим документ
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		
		ОтменитьТранзакцию();
		
		Ответ = Новый HTTPСервисОтвет(500);
		Ответ.УстановитьТелоИзСтроки(ТекстОшибки);
		
		Возврат Ответ;
		
	КонецПопытки;
	
	#КонецОбласти
	
	#Область ФормированиеОтвета
	
	// Рассчитываем общую сумму документа
	ОбщаяСумма = 0;
	
	Для Каждого СтрокаДокумента Из ДокументОбъект.Товары Цикл
		ОбщаяСумма = ОбщаяСумма + СтрокаДокумента.Сумма;
	КонецЦикла;
	
	// Формируем данные ответа
	ДанныеОтвета = Новый Структура;
	
	ДанныеОтвета.Вставить("Статус", "Успешно");
	ДанныеОтвета.Вставить("Сообщение", "Документ поступления успешно оформлен");
	ДанныеОтвета.Вставить("НомерДокумента", ДокументОбъект.Номер);
	ДанныеОтвета.Вставить("ДатаДокумента", ДокументОбъект.Дата);
	ДанныеОтвета.Вставить("СуммаДокумента", ОбщаяСумма);
	
	// Преобразуем ответ в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, ДанныеОтвета);
	
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	// Возвращаем ответ внешней системе
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON);
	
	Возврат Ответ;
	#КонецОбласти
	
КонецФункции

#КонецОбласти
