#Область ОбработчикиСобытий
// Формирует движения.
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.СтоимостьТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	
	Для Каждого ТекущаяСтрокаТоваров Из Товары Цикл 
		
		// регистр ОстаткиТоваров Расход
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекущаяСтрокаТоваров.Товар;
		Движение.Склад = Склад;
		Движение.Количество = ТекущаяСтрокаТоваров.Количество;
		
		// регистр СтоимостьТоваров Расход
		Движение = Движения.СтоимостьТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекущаяСтрокаТоваров.Товар;
		Движение.Стоимость = ТекущаяСтрокаТоваров.Количество * ТекущаяСтрокаТоваров.Стоимость;
		
		// Регистр Продажи 
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Товар = ТекущаяСтрокаТоваров.Товар;
		Движение.Контрагент = Контрагент;
		Движение.Количество = ТекущаяСтрокаТоваров.Количество;
		Движение.Выручка = ТекущаяСтрокаТоваров.Сумма;
		Движение.Стоимость = ТекущаяСтрокаТоваров.Стоимость * ТекущаяСтрокаТоваров.Количество;
		
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти