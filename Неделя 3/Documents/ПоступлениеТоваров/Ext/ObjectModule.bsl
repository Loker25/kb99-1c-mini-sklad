#Область ОбработчикиСобытий
// Формирует движения.
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.СтоимостьТоваров.Записывать = Истина;
	
	Для Каждого ТекущаяСтрокаТоваров Из Товары Цикл
		
		Если Не ЗначениеЗаполнено(ТекущаяСтрокаТоваров.НаборСвойств) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не указана партия для товара: " + Строка(ТекущаяСтрокаТоваров.Товар) + ".";
			Сообщение.Сообщить();
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		// регистр ОстаткиТоваров Приход
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = ТекущаяСтрокаТоваров.Товар;
		Движение.НаборСвойств = ТекущаяСтрокаТоваров.НаборСвойств;
		Движение.Склад = Склад;
		Движение.Количество = ТекущаяСтрокаТоваров.Количество;
		
		// регистр СтоимостьТоваров Приход
		Движение = Движения.СтоимостьТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = ТекущаяСтрокаТоваров.Товар;
		Движение.Склад = Склад;
		Движение.НаборСвойств = ТекущаяСтрокаТоваров.НаборСвойств;
		Движение.Стоимость = ТекущаяСтрокаТоваров.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры
#КонецОбласти