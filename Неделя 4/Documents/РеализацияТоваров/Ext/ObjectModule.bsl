
#Область ОбработчикиСобытий
// Формирует движения документа с учетом списания партий по FIFO.
Процедура ОбработкаПроведения(Отказ, Режим)
	
	#Область ПроверкаДанныхДокумента
	// Проверяем положительность количества в строках реализации.
	Для Каждого СтрокаТоваров Из Товары Цикл
		
		Если СтрокаТоваров.Количество <= 0 Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Количество товара должно быть больше нуля: "
			+ Строка(СтрокаТоваров.Товар) + ".";
			Сообщение.Сообщить();
			
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	#КонецОбласти
	
	// Определяем регистры, в которые будут записываться движения.
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.СтоимостьТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	
	// Создаем менеджер временных таблиц.
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	
	// Определяем параметры запросов.
	ПериодОстатков = Дата;
	ВидСвойстваДатаПоступления = ПланыВидовХарактеристик.СвойстваТоваров.НайтиПоНаименованию("ДатаПоступления");
	
	Если Не ЗначениеЗаполнено(ВидСвойстваДатаПоступления) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В плане видов характеристик не найдено свойство 'ДатаПоступления'.";
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	#Область ПодготовкаДанныхДокумента
	// Формируем временную таблицу с товарами документа.
	ЗапросТоваровДокумента = Новый Запрос;
	ЗапросТоваровДокумента.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросТоваровДокумента.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровТовары.Товар КАК Товар,
	|	СУММА(РеализацияТоваровТовары.Количество) КАК КоличествоВДокументе,
	|	СУММА(РеализацияТоваровТовары.Сумма) КАК СуммаВДокументе
	|ПОМЕСТИТЬ ТоварыДокумента
	|ИЗ
	|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	|ГДЕ
	|	РеализацияТоваровТовары.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровТовары.Товар";
	
	ЗапросТоваровДокумента.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = ЗапросТоваровДокумента.Выполнить();
	#КонецОбласти
	
	#Область БлокировкаРегистров
	// Устанавливаем блокировки перед чтением остатков.
	Движения.ОстаткиТоваров.БлокироватьДляИзменения = Истина;
	Движения.СтоимостьТоваров.БлокироватьДляИзменения = Истина;
	
	// Записываем пустые наборы, чтобы не учитывать прежние движения этого документа при получении остатков.
	Движения.ОстаткиТоваров.Записать();
	Движения.СтоимостьТоваров.Записать();
	#КонецОбласти
	
	#Область ПолучениеПартийТоваров
	// Получаем количество, стоимость и дату поступления партий.
	ЗапросПартий = Новый Запрос;
	ЗапросПартий.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросПартий.Текст =
	"ВЫБРАТЬ
	|	ТоварыДокумента.Товар КАК Товар,
	|	ТоварыДокумента.КоличествоВДокументе КАК КоличествоВДокументе,
	|	ТоварыДокумента.СуммаВДокументе КАК СуммаВДокументе,
	|	ОстаткиТоваровОстатки.Склад КАК Склад,
	|	ОстаткиТоваровОстатки.НаборСвойств КАК НаборСвойств,
	|	ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ЕСТЬNULL(СтоимостьТоваровОстатки.СтоимостьОстаток, 0) КАК СтоимостьОстаток,
	|	ЗначенияСвойствТоваров.Значение КАК ДатаПоступления
	|ПОМЕСТИТЬ ПартииТоваров
	|ИЗ
	|	ТоварыДокумента КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&ПериодОстатков,
	|				Товар В
	|						(ВЫБРАТЬ
	|							ТоварыДокумента.Товар
	|						ИЗ
	|							ТоварыДокумента)
	|					И Склад = &Склад) КАК ОстаткиТоваровОстатки
	|		ПО ТоварыДокумента.Товар = ОстаткиТоваровОстатки.Товар
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьТоваров.Остатки(
	|				&ПериодОстатков,
	|				Товар В
	|						(ВЫБРАТЬ
	|							ТоварыДокумента.Товар
	|						ИЗ
	|							ТоварыДокумента)
	|					И Склад = &Склад) КАК СтоимостьТоваровОстатки
	|		ПО (ОстаткиТоваровОстатки.Товар = СтоимостьТоваровОстатки.Товар)
	|			И (ОстаткиТоваровОстатки.Склад = СтоимостьТоваровОстатки.Склад)
	|			И (ОстаткиТоваровОстатки.НаборСвойств = СтоимостьТоваровОстатки.НаборСвойств)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствТоваров КАК ЗначенияСвойствТоваров
	|		ПО (ОстаткиТоваровОстатки.НаборСвойств = ЗначенияСвойствТоваров.НаборСвойств)
	|			И (ЗначенияСвойствТоваров.ВидСвойства = &ВидСвойстваДатаПоступления)
	|ГДЕ
	|	ОстаткиТоваровОстатки.КоличествоОстаток > 0";
	
	ЗапросПартий.УстановитьПараметр("ПериодОстатков", ПериодОстатков);
	ЗапросПартий.УстановитьПараметр("Склад", Склад);
	ЗапросПартий.УстановитьПараметр("ВидСвойстваДатаПоступления", ВидСвойстваДатаПоступления);
	
	РезультатЗапроса = ЗапросПартий.Выполнить();
	
	#Область ПроверкаДатПоступленияПартий
	// Проверяем даты поступления всех доступных партий.
	ЗапросПроверкиДат = Новый Запрос;
	ЗапросПроверкиДат.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросПроверкиДат.Текст =
	"ВЫБРАТЬ
	|	ПартииТоваров.НаборСвойств КАК НаборСвойств,
	|	ПартииТоваров.ДатаПоступления КАК ДатаПоступления
	|ИЗ
	|	ПартииТоваров КАК ПартииТоваров";
	
	РезультатПроверкиДат = ЗапросПроверкиДат.Выполнить();
	ВыборкаПроверкиДат = РезультатПроверкиДат.Выбрать();
	
	Пока ВыборкаПроверкиДат.Следующий() Цикл
		
		Если Не ЗначениеЗаполнено(ВыборкаПроверкиДат.ДатаПоступления) Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не указана дата поступления партии: "
			+ Строка(ВыборкаПроверкиДат.НаборСвойств) + ".";
			Сообщение.Сообщить();
			
			Отказ = Истина;
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	#КонецОбласти
	#КонецОбласти
	
	#Область КонтрольДостаточностиОстатков
	// Проверяем, хватает ли товара для реализации.
	ЗапросКонтроля = Новый Запрос;
	ЗапросКонтроля.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросКонтроля.Текст =
	"ВЫБРАТЬ
	|	ТоварыДокумента.Товар КАК Товар,
	|	ТоварыДокумента.КоличествоВДокументе КАК КоличествоВДокументе,
	|	СУММА(ЕСТЬNULL(ПартииТоваров.КоличествоОстаток, 0)) КАК КоличествоОстатокВсего,
	|	ВЫБОР
	|		КОГДА СУММА(ЕСТЬNULL(ПартииТоваров.КоличествоОстаток, 0)) < ТоварыДокумента.КоличествоВДокументе
	|			ТОГДА ""Недостаточно""
	|		ИНАЧЕ ""Достаточно""
	|	КОНЕЦ КАК РезультатПроверки
	|ИЗ
	|	ТоварыДокумента КАК ТоварыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПартииТоваров КАК ПартииТоваров
	|		ПО ТоварыДокумента.Товар = ПартииТоваров.Товар
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыДокумента.Товар,
	|	ТоварыДокумента.КоличествоВДокументе";
	
	РезультатКонтроля = ЗапросКонтроля.Выполнить();
	ВыборкаКонтроля = РезультатКонтроля.Выбрать();
	
	ЕстьНедостатокОстатков = Ложь;
	
	Пока ВыборкаКонтроля.Следующий() Цикл
		
		Если ВыборкаКонтроля.РезультатПроверки = "Недостаточно" Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Недостаточно остатка товара: " + Строка(ВыборкаКонтроля.Товар)
			+ ". Требуется: " + Строка(ВыборкаКонтроля.КоличествоВДокументе)
			+ ", доступно: " + Строка(ВыборкаКонтроля.КоличествоОстатокВсего)
			+ ".";
			Сообщение.Сообщить();
			ЕстьНедостатокОстатков = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьНедостатокОстатков Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	#КонецОбласти
	
	#Область ПодготовкаПартийКСписанию
	// Получаем партии в порядке FIFO: сначала более ранняя дата поступления.
	ЗапросВыборкиПартий = Новый Запрос;
	ЗапросВыборкиПартий.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросВыборкиПартий.Текст =
	"ВЫБРАТЬ
	|	ПартииТоваров.Товар КАК Товар,
	|	ПартииТоваров.Склад КАК Склад,
	|	ПартииТоваров.НаборСвойств КАК НаборСвойств,
	|	ПартииТоваров.ДатаПоступления КАК ДатаПоступления,
	|	ПартииТоваров.КоличествоВДокументе КАК КоличествоВДокументе,
	|	ПартииТоваров.СуммаВДокументе КАК СуммаВДокументе,
	|	ПартииТоваров.КоличествоОстаток КАК КоличествоОстаток,
	|	ПартииТоваров.СтоимостьОстаток КАК СтоимостьОстаток
	|ИЗ
	|	ПартииТоваров КАК ПартииТоваров
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПартииТоваров.Товар,
	|	ПартииТоваров.ДатаПоступления,
	|	ПартииТоваров.НаборСвойств";
	
	РезультатЗапроса = ЗапросВыборкиПартий.Выполнить();
	ВыборкаПартий = РезультатЗапроса.Выбрать();
	#КонецОбласти
	
	#Область РаспределениеТоваровПоПартиям
	// Храним общую себестоимость списания по каждому товару.
	СтоимостьПоТоварам = Новый Соответствие;
	
	ТекущийТовар = Неопределено;
	ОсталосьСписать = 0;
	
	Пока ВыборкаПартий.Следующий() Цикл
		
		// При переходе к следующему товару проверяем, полностью ли распределено количество предыдущего товара.
		Если ТекущийТовар <> ВыборкаПартий.Товар Тогда
			
			Если ТекущийТовар <> Неопределено И ОсталосьСписать > 0 Тогда
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не удалось полностью распределить количество товара: " + Строка(ТекущийТовар) + ".";
				Сообщение.Сообщить();
				
				Отказ = Истина;
				Возврат;
				
			КонецЕсли;
			
			ТекущийТовар = ВыборкаПартий.Товар;
			ОсталосьСписать = ВыборкаПартий.КоличествоВДокументе;
			
		КонецЕсли;
		
		// Если необходимое количество уже списано,переходим к следующей партии.
		Если ОсталосьСписать <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Определяем количество для списания из текущей партии.
		КоличествоСписания = ОсталосьСписать;
		
		Если ВыборкаПартий.КоличествоОстаток < КоличествоСписания Тогда
			КоличествоСписания = ВыборкаПартий.КоличествоОстаток;
		КонецЕсли;
		
		// Рассчитываем себестоимость списания из партии. При полном списании используем всю остаточную стоимость.
		Если КоличествоСписания = ВыборкаПартий.КоличествоОстаток Тогда
			СтоимостьСписания = ВыборкаПартий.СтоимостьОстаток;
		Иначе
			СтоимостьСписания = Окр(ВыборкаПартий.СтоимостьОстаток / ВыборкаПартий.КоличествоОстаток * КоличествоСписания,2);
		КонецЕсли;
		
		// Уменьшаем количество, которое осталось списать.
		ОсталосьСписать = ОсталосьСписать - КоличествоСписания;
		
		// Получаем накопленную себестоимость текущего товара.
		СтоимостьТовара = СтоимостьПоТоварам.Получить(ВыборкаПартий.Товар);
		
		Если СтоимостьТовара = Неопределено Тогда
			СтоимостьТовара = 0;
		КонецЕсли;
		
		// Добавляем стоимость списанной партии.
		СтоимостьТовара = СтоимостьТовара + СтоимостьСписания;
		
		СтоимостьПоТоварам.Вставить(ВыборкаПартий.Товар, СтоимостьТовара);
		
		// Регистр ОстаткиТоваров Расход.
		ДвижениеОстатков = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстатков.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстатков.Период = Дата;
		ДвижениеОстатков.Товар = ВыборкаПартий.Товар;
		ДвижениеОстатков.Склад = ВыборкаПартий.Склад;
		ДвижениеОстатков.НаборСвойств = ВыборкаПартий.НаборСвойств;
		ДвижениеОстатков.Количество = КоличествоСписания;
		
		// Регистр СтоимостьТоваров Расход.
		ДвижениеСтоимость = Движения.СтоимостьТоваров.Добавить();
		ДвижениеСтоимость.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеСтоимость.Период = Дата;
		ДвижениеСтоимость.Товар = ВыборкаПартий.Товар;
		ДвижениеСтоимость.Склад = ВыборкаПартий.Склад;
		ДвижениеСтоимость.НаборСвойств = ВыборкаПартий.НаборСвойств;
		ДвижениеСтоимость.Стоимость = СтоимостьСписания;
		
	КонецЦикла;
	
	// Проверяем распределение последнего товара.
	Если ТекущийТовар <> Неопределено И ОсталосьСписать > 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось полностью распределить количество товара: " + Строка(ТекущийТовар) + ".";
		Сообщение.Сообщить();
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	#КонецОбласти
	
	#Область ФормированиеДвиженийПродаж
	// Получаем сводные данные документа по товарам.
	ЗапросПродаж = Новый Запрос;
	ЗапросПродаж.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросПродаж.Текст =
	"ВЫБРАТЬ
	|	ТоварыДокумента.Товар КАК Товар,
	|	ТоварыДокумента.КоличествоВДокументе КАК КоличествоВДокументе,
	|	ТоварыДокумента.СуммаВДокументе КАК СуммаВДокументе
	|ИЗ
	|	ТоварыДокумента КАК ТоварыДокумента";
	
	РезультатПродаж = ЗапросПродаж.Выполнить();
	ВыборкаПродаж = РезультатПродаж.Выбрать();
	
	Пока ВыборкаПродаж.Следующий() Цикл
		
		// Получаем общую себестоимость списанных партий товара.
		СтоимостьТовара = СтоимостьПоТоварам.Получить(ВыборкаПродаж.Товар);
		
		Если СтоимостьТовара = Неопределено Тогда
			СтоимостьТовара = 0;
		КонецЕсли;
		
		// Регистр Продажи.
		ДвижениеПродаж = Движения.Продажи.Добавить();
		ДвижениеПродаж.Период = Дата;
		ДвижениеПродаж.Товар = ВыборкаПродаж.Товар;
		ДвижениеПродаж.Контрагент = Контрагент;
		ДвижениеПродаж.Количество = ВыборкаПродаж.КоличествоВДокументе;
		ДвижениеПродаж.Выручка = ВыборкаПродаж.СуммаВДокументе;
		ДвижениеПродаж.Стоимость = СтоимостьТовара;
		
	КонецЦикла;
	
	// Записываем сформированные движения регистров.
	Движения.Записать();
	#КонецОбласти
	
КонецПроцедуры
#КонецОбласти
