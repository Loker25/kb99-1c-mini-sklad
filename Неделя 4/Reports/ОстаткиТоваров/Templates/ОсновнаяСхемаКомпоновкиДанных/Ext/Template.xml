		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НаборСвойств</dataPath>
			<field>НаборСвойств</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Товары.Ссылка КАК Товар,
	СУММА(ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0)) КАК КоличествоОстаток
ИЗ
	Справочник.Товары КАК Товары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(КОНЕЦПЕРИОДА(&amp;ДатаОстатков, ДЕНЬ), Склад = &amp;Склад) КАК ОстаткиТоваровОстатки
		ПО Товары.Ссылка = ОстаткиТоваровОстатки.Товар
ГДЕ
	Товары.ЭтоГруппа = ЛОЖЬ

СГРУППИРОВАТЬ ПО
	Товары.Ссылка</query>
	</dataSet>
	<totalField>
