#Область ПубличныйИнтерфейс
Процедура ПроверитьМинимальныеОстатки(МинимальныйОстаток = 10) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиТоваровОстатки.Товар КАК Товар,
	|	ОстаткиТоваровОстатки.Склад КАК Склад,
	|	ОстаткиТоваровОстатки.НаборСвойств КАК НаборСвойств,
	|	ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, ИСТИНА) КАК ОстаткиТоваровОстатки
	|ГДЕ
	|	ОстаткиТоваровОстатки.КоличествоОстаток < &МинимальныйОстаток";
	
	Запрос.УстановитьПараметр("Момент", ТекущаяДата());
	Запрос.УстановитьПараметр("МинимальныйОстаток", МинимальныйОстаток);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаОстатков = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаОстатков.Следующий() Цикл
		
		ТекстСообщения = "Низкий остаток товара: "
		+ Строка(ВыборкаОстатков.Товар) + ". Склад: "
		+ Строка(ВыборкаОстатков.Склад) + ". Количество: "
		+ Строка(ВыборкаОстатков.КоличествоОстаток) + ". Минимум: "
		+ Строка(МинимальныйОстаток);
		
		ЗаписьЖурналаРегистрации("КонтрольМинимальныхОстатков", УровеньЖурналаРегистрации.Предупреждение,,, ТекстСообщения);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьСтатистикуДокументов() Экспорт
	
	// Статистика ведётся только по проведённым документам: они отражают фактическое движение товаров.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПоступлениеТоваров.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|ГДЕ
	|	ПоступлениеТоваров.Проведен = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваров.Ссылка) КАК Количество
	|ИЗ
	|	Документ.РеализацияТоваров КАК РеализацияТоваров
	|ГДЕ
	|	РеализацияТоваров.Проведен = ИСТИНА";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаПоступлений = РезультатыЗапроса[0].Выбрать();
	ВыборкаПоступлений.Следующий();
	КоличествоПоступлений = ВыборкаПоступлений.Количество;
	
	ВыборкаРеализаций = РезультатыЗапроса[1].Выбрать();
	ВыборкаРеализаций.Следующий();
	КоличествоРеализаций = ВыборкаРеализаций.Количество;
	
	НаименованиеСводкиПоПоступлениям = "Сводка по поступлениям";
	НаименованиеСводкиПоРеализациям = "Сводка по реализациям";
	ВидДокументаПоступление = "Поступление";
	ВидДокументаРеализация = "Реализация";
	
	ЗаписатьСтрокуСтатистики(НаименованиеСводкиПоПоступлениям, ВидДокументаПоступление, КоличествоПоступлений);
	ЗаписатьСтрокуСтатистики(НаименованиеСводкиПоРеализациям, ВидДокументаРеализация, КоличествоРеализаций);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

Процедура ЗаписатьСтрокуСтатистики(НаименованиеСводки, ВидДокумента, НовоеКоличество)
	
	СсылкаНаЭлемент = Справочники.СтатистикаДокументов.НайтиПоНаименованию(НаименованиеСводки);
	
	Если СсылкаНаЭлемент.Пустая() Тогда
		ОбъектСправочника = Справочники.СтатистикаДокументов.СоздатьЭлемент();
		ОбъектСправочника.Наименование = НаименованиеСводки;
	Иначе
		ОбъектСправочника = СсылкаНаЭлемент.ПолучитьОбъект();
	КонецЕсли;
	
	ОбъектСправочника.ВидДокумента = ВидДокумента;
	ОбъектСправочника.КоличествоПроведенных = НовоеКоличество;
	ОбъектСправочника.ДатаОбновления = ТекущаяДата();
	ОбъектСправочника.Записать();
	
КонецПроцедуры

#КонецОбласти